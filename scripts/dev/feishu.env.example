# Copy this file to scripts/dev/feishu.env. Files ending in .env are ignored by Git.
# Never commit real Feishu credentials.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace-me
FEISHU_VERIFICATION_TOKEN=replace-me

# Phase 1: leave empty and configure plaintext events in Feishu.
# Phase 2: set the same Encrypt Key here and in the Feishu developer console.
FEISHU_ENCRYPT_KEY=

FEISHU_LOG_LEVEL=INFO
FEISHU_LOG_RAW=0
# Empty disables file logging. Relative paths are resolved from the working directory.
FEISHU_LOG_FILE=logs/feishu_echo.log
